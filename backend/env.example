# Configuration template — copy to `.env` and adjust as needed.
#   cp env.example .env

# Optional. When missing, /ask-audio and /chat return mock answers instead of
# calling OpenAI.
OPENAI_API_KEY=

# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# Compute device: cpu | cuda | auto
DEVICE=cpu

# Max upload size in megabytes. Larger files are rejected with a 413 response.
MAX_UPLOAD_SIZE_MB=25

# Comma-separated list of allowed CORS origins, or * for any origin.
CORS_ORIGINS=*
